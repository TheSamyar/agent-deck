{
  "manifest_version": 3,
  "name": "Agent Deck Browser Bridge",
  "version": "0.1.0",
  "description": "Local Jarvis control of explicitly approved sites.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
